<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--Splash Screen Definition-->
    <style name="Theme.ClassScheduler.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <!--What to show after the splash screen?-->
        <item name="postSplashScreenTheme">@style/Theme.ClassScheduler</item>
    </style>

    <style name="Theme.ClassScheduler" parent="android:Theme.Material.Light.NoActionBar" />
</resources>